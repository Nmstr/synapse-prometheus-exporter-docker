services:
  synapse-prometheus-exporter:
    container_name: synapse-prometheus-exporter
    image: ghcr.io/nmstr/synapse-prometheus-exporter-docker:latest
    restart: unless-stopped
    volumes:
      - ./config.yaml:/app/config.yaml:ro
    ports:
      - "8999:8999"  # Only needs to be published if prometheus is not on the same docker network

